---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogHeader from '../../components/catalog/CatalogHeader.astro';
import FilterPanel from '../../components/catalog/FilterPanel.astro';
import CatalogToolbar from '../../components/catalog/CatalogToolbar.astro';
import CatalogGrid from '../../components/catalog/CatalogGrid.astro';
import CatalogEmpty from '../../components/catalog/CatalogEmpty.astro';
import { getProductos, getDestacados } from '../../lib/catalog';
import {
  categoriasConProductos,
  celdasCatalogo,
  facetasColor,
  facetasOcasion,
  limitesPrecio,
} from '../../lib/catalogFacets';

const productos = await getProductos();
const destacados = await getDestacados();
const categorias = categoriasConProductos(productos);
const celdas = celdasCatalogo(productos, destacados);
const ocasiones = facetasOcasion(productos);
const colores = facetasColor(productos);
const precio = limitesPrecio(productos);
---

<BaseLayout title="Catálogo" description="Catálogo de Florería V'Lirio: ramos, buchones, arreglos, box, tulipanes, peluches y chocolates en Lima. Filtra por tipo y ocasión y pide por WhatsApp.">
  <CatalogHeader total={productos.length} categorias={categorias} />

  <section class="listado">
    <div class="wrap layout">
      <FilterPanel total={productos.length} ocasiones={ocasiones} colores={colores} precio={precio} />

      <div class="main">
        <CatalogToolbar total={productos.length} />

        <h2 class="sr-only">Productos del catálogo</h2>
        <CatalogGrid celdas={celdas} />
        <CatalogEmpty />
      </div>
    </div>
  </section>

  <script>
    import { initCatalog } from '../../components/catalog/catalogFilters';
    import { initFilterSheet } from '../../components/catalog/filterSheet';
    initCatalog();
    initFilterSheet();
  </script>
</BaseLayout>

<style>
  .listado {
    padding-bottom: 72px;
  }
  .layout {
    display: block;
  }
  .main {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 32px;
      align-items: start;
    }
  }
</style>
