---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Catálogo" description="Catálogo de Florería V'Lirio: ramos, buchones, arreglos, box y tulipanes en Lima.">
  <section class="stub wrap">
    <h1 class="title">Catálogo</h1>
    <p class="texto">Próximamente: filtros por categoría y ocasión</p>
    <a class="btn btn-ghost" href="/">Volver al inicio</a>
  </section>
</BaseLayout>

<style>
  .stub {
    padding-top: 140px;
    padding-bottom: 96px;
  }
  .texto {
    margin: 12px 0 28px;
    color: var(--vl-tinta-suave);
    font-size: 18px;
  }
</style>
