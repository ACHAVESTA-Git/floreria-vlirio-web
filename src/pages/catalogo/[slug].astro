---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import ProductBreadcrumb from '../../components/product/ProductBreadcrumb.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductInfo from '../../components/product/ProductInfo.astro';
import ProductBuy from '../../components/product/ProductBuy.astro';
import { getProductos, precioFinal, type Producto } from '../../lib/catalog';

export async function getStaticPaths() {
  const productos = await getProductos();
  return productos.map((producto) => ({ params: { slug: producto.id }, props: { producto } }));
}

interface Props {
  producto: Producto;
}

const NOMBRE_CATEGORIA: Record<Producto['data']['categoria'], string> = {
  ramos: 'Ramos',
  buchones: 'Buchones',
  arreglos: 'Arreglos',
  box: 'Box',
  tulipanes: 'Tulipanes',
  cumpleanos: 'Cumpleaños',
  extras: 'Peluches y chocolates',
};

const { producto } = Astro.props;
const { nombre, descripcion, categoria, imagen } = producto.data;
const categoriaNombre = NOMBRE_CATEGORIA[categoria];
const vigente = precioFinal(producto.data);

// "También te puede gustar": misma categoría primero; si faltan, otros productos que no sean de 'extras'.
const todos = await getProductos();
const misma = todos.filter((p) => p.id !== producto.id && p.data.categoria === categoria);
const otros = todos.filter(
  (p) => p.id !== producto.id && p.data.categoria !== categoria && p.data.categoria !== 'extras',
);
const relacionados = [...misma, ...otros].slice(0, 4);

// Datos estructurados Product (schema.org). La imagen necesita URL absoluta: requiere `site` en astro.config.
const imagenSeo = await getImage({ src: imagen, width: 960, format: 'webp' });
const urlImagen = Astro.site ? new URL(imagenSeo.src, Astro.site).href : imagenSeo.src;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  description: descripcion,
  image: [urlImagen],
  offers: {
    '@type': 'Offer',
    priceCurrency: 'PEN',
    price: vigente,
  },
};
---

<BaseLayout title={nombre} description={descripcion}>
  <section class="detalle wrap">
    <ProductBreadcrumb categoria={categoria} categoriaNombre={categoriaNombre} nombre={nombre} />

    <div class="grid">
      <ProductGallery producto={producto} />

      <div class="info">
        <ProductInfo producto={producto} categoriaNombre={categoriaNombre} />
        <ProductBuy producto={producto} />
      </div>
    </div>
  </section>

  {
    relacionados.length > 0 && (
      <section class="relacionados wrap" aria-labelledby="relacionados-titulo">
        <h2 class="title" id="relacionados-titulo">También te puede gustar</h2>
        <div class="rejilla">
          {relacionados.map((p) => (
            <ProductCard producto={p} />
          ))}
        </div>
      </section>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .detalle {
    padding-top: 120px;
    padding-bottom: 72px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .info {
    min-width: 0;
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
  }

  .relacionados {
    padding-top: 40px;
    padding-bottom: 96px;
    border-top: 1px solid var(--vl-durazno);
  }
  .relacionados .title {
    margin-bottom: 32px;
    font-size: clamp(26px, 3.4vw, 36px);
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--vl-card-w));
    justify-content: center;
    gap: 20px;
  }
</style>
