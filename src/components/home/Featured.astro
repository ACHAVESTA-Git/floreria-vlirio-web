---
import ProductCard from '../product/ProductCard.astro';
import { getDestacados } from '../../lib/catalog';

const destacados = await getDestacados();
---

<section class="block featured" id="destacados" aria-labelledby="destacados-titulo">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="script">hechos con amor</p>
        <h2 class="title" id="destacados-titulo">Los más pedidos</h2>
      </div>
      <a class="ver" href="/catalogo">
        Ver todo el catálogo
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-arrow" /></svg>
      </a>
    </div>

    <div class="carrusel">
      <button type="button" class="flecha" data-dir="-1" aria-label="Ver productos anteriores">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-arrow" /></svg>
      </button>
      <div class="rail" id="railDestacados" role="region" aria-label="Productos más pedidos" tabindex="0">
        {destacados.map((p) => <ProductCard producto={p} />)}
      </div>
      <button type="button" class="flecha" data-dir="1" aria-label="Ver más productos">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-arrow" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const rail = document.getElementById('railDestacados');

  document.querySelectorAll<HTMLButtonElement>('.featured .flecha').forEach((boton) => {
    boton.addEventListener('click', () => {
      if (!rail) return;
      const dir = Number(boton.dataset.dir) || 1;
      const tarjeta = rail.querySelector<HTMLElement>('.card');
      const gap = parseFloat(getComputedStyle(rail).columnGap) || 20;
      const paso = tarjeta ? tarjeta.offsetWidth + gap : 300;
      const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      rail.scrollBy({ left: dir * paso, behavior: reducir ? 'auto' : 'smooth' });
    });
  });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .head .script { font-size: 34px; line-height: 1; margin-bottom: 6px; }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--vl-font-ui);
    font-weight: 600;
    font-size: 15px;
    color: var(--vl-vino);
    border-bottom: 1.5px solid var(--vl-rosa);
    padding-bottom: 2px;
  }
  .ver:hover { color: var(--vl-frambuesa); border-color: var(--vl-frambuesa); }

  .carrusel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }
  .flecha {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--vl-blanco);
    box-shadow: var(--vl-shadow);
    color: var(--vl-vino);
    transition: transform 0.3s var(--vl-ease), background 0.3s;
  }
  .flecha:hover { background: var(--vl-vino); color: var(--vl-blanco); }
  .flecha[data-dir="-1"] svg { transform: scaleX(-1); }

  .rail {
    display: flex;
    gap: 20px;
    min-width: 0;
    margin-inline: -16px;
    padding: 8px 16px 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }

  @media (min-width: 900px) {
    .carrusel { grid-template-columns: 48px minmax(0, 1fr) 48px; }
    .flecha { display: grid; }
    .rail { margin-inline: 0; padding: 8px 4px 32px; scroll-padding-inline: 4px; }
  }
</style>
