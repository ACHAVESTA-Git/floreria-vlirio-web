---
import HeroTulips from './HeroTulips.astro';
import HeroPhotos from './HeroPhotos.astro';
import { waLink } from '../../config/site';

/** Pétalos decorativos: [left %, top %, rotación, escala]. Posiciones fijas para que el render sea estable. */
const PETALOS: [number, number, number, number][] = [
  [12, 18, 40, 0.9],
  [24, 64, 150, 0.7],
  [33, 22, 260, 1.1],
  [45, 40, 80, 0.8],
  [58, 14, 200, 1],
  [66, 58, 310, 0.7],
  [74, 30, 20, 1.2],
  [84, 48, 120, 0.8],
  [90, 20, 290, 0.9],
];

const CTA_WA = waLink("Hola V'Lirio 🌷, quiero hacer un pedido");
---

<section class="hero" id="inicio" aria-label="Bienvenida">
  <div class="stage">
    <div class="hero-intro" id="heroIntro">
      <p>FLORERÍA EN COMAS · LIMA</p>
      <div class="script">bienvenido a V'Lirio</div>
    </div>

    <HeroTulips />

    {
      PETALOS.map(([x, y, r, s]) => (
        <span class="petal" style={`--x:${x}%;--y:${y}%;--r:${r}deg;--s:${s}`} aria-hidden="true" />
      ))
    }

    <div class="message" id="message">
      <h1 class="msg-h">
        <span class="l sm">Aquí no solo vendemos flores,</span>
        <span class="l">entregamos momentos</span>
        <span class="l s">que llegan al corazón</span>
      </h1>
      <div class="hero-cta" id="heroCta">
        <a href="/#categorias" class="btn btn-primary">
          Ver catálogo <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
        <a class="btn btn-ghost" href={CTA_WA} target="_blank" rel="noopener">
          <svg width="18" height="18" aria-hidden="true"><use href="#i-wa" /></svg> Pedir por WhatsApp
        </a>
      </div>
    </div>

    <HeroPhotos />

    <div class="scroll-hint" id="scrollHint" aria-hidden="true"><i></i>Desliza para descubrir</div>
  </div>
  <noscript>
    <style>
      .hero .hero-photo,
      .hero .message .l,
      .hero .hero-cta {
        opacity: 1 !important;
      }
    </style>
  </noscript>
</section>

<script>
  import { initHeroScroll } from './heroScroll';

  initHeroScroll();
</script>

<style>
  /* ---------- Sección y stage ---------- */
  .hero {
    height: 330vh;
    position: relative;
    background: linear-gradient(180deg, var(--vl-crema) 0%, var(--vl-blush) 55%, var(--vl-crema) 100%);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  /* ---------- Pétalos ---------- */
  .petal {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 18px;
    height: 22px;
    border-radius: 60% 0 60% 0;
    background: var(--vl-rosa);
    opacity: 0.7;
    transform: rotate(var(--r)) scale(var(--s));
  }

  /* ---------- Mensaje ---------- */
  .message {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 0 16px;
    max-width: 900px;
    margin-top: -4vh;
  }
  .msg-h {
    font: inherit;
    margin: 0;
  }
  .msg-h .l {
    display: block;
    font-family: var(--vl-font-title);
    font-weight: 900;
    color: var(--vl-vino);
    font-size: clamp(30px, 5.4vw, 66px);
    line-height: 1.08;
  }
  .msg-h .l.s {
    font-family: var(--vl-font-script);
    font-weight: 400;
    font-size: clamp(40px, 8vw, 104px);
    line-height: 1.1;
    color: var(--vl-frambuesa);
  }
  .msg-h .l.sm {
    font-size: clamp(22px, 3.4vw, 40px);
    font-weight: 800;
    color: var(--vl-tinta);
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  /* ---------- Pista de scroll ---------- */
  .scroll-hint {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    font-family: var(--vl-font-ui);
    font-size: 13px;
    color: var(--vl-vino);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .scroll-hint i {
    width: 22px;
    height: 34px;
    border: 2px solid var(--vl-vino);
    border-radius: 20px;
    position: relative;
  }
  .scroll-hint i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 6px;
    width: 4px;
    height: 7px;
    margin-left: -2px;
    background: var(--vl-vino);
    border-radius: 4px;
    animation: wheel 1.6s infinite;
  }
  @keyframes wheel {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .hero-intro {
    position: absolute;
    top: 22%;
    left: 0;
    right: 0;
    text-align: center;
    z-index: 3;
  }
  .hero-intro .script {
    font-size: clamp(40px, 6vw, 74px);
  }
  .hero-intro p {
    font-family: var(--vl-font-ui);
    color: var(--vl-tinta-suave);
    font-size: 15px;
    letter-spacing: 0.06em;
  }

  /* ---------- Móvil: pin más corto ---------- */
  @media (max-width: 700px) {
    .hero {
      height: 230vh;
    }
  }

  /* ---------- Estado estático (reduced-motion o sin GSAP) ---------- */
  /* Antes de que GSAP esté listo, el mensaje y los CTAs permanecen ocultos (evita el parpadeo). */
  .hero:not(.static) .message .l,
  .hero:not(.static) .hero-cta {
    opacity: 0;
  }
  .hero.static {
    height: auto;
  }
  .hero.static .stage {
    position: relative;
    height: auto;
    min-height: 100vh;
    overflow: visible;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    gap: 24px 20px;
    padding: 120px 16px 80px;
  }
  .hero.static .message {
    flex: 0 0 100%;
    margin-top: 0;
  }
  .hero.static .hero-intro,
  .hero.static .scroll-hint,
  .hero.static .petal {
    display: none;
  }
</style>
