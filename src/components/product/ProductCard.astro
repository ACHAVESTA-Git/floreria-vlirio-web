---
import { Image } from 'astro:assets';
import type { Producto } from '../../lib/catalog';
import { soles, waLink } from '../../config/site';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const { nombre, descripcion, precio, precioOferta, imagen } = producto.data;

// Solo hay oferta si el precio de oferta es menor al normal.
const oferta = precioOferta !== undefined && precioOferta < precio ? precioOferta : undefined;
const actual = oferta ?? precio;
const descuento = oferta !== undefined ? Math.round((1 - oferta / precio) * 100) : 0;
const alt = `${nombre}: ${descripcion}`;
const mensajeWa = `Hola V'Lirio 🌷, quiero el ${nombre} (${soles(actual)}). ¿Está disponible?`;
---

<article class="card" data-producto={producto.id}>
  <div class="ph">
    {oferta !== undefined && <span class="badge">-{descuento}%</span>}
    <Image
      src={imagen}
      widths={[240, 360, 480]}
      sizes="(max-width: 480px) 240px, 272px"
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    <button
      type="button"
      class="fav"
      data-fav={producto.id}
      data-nombre={nombre}
      aria-pressed="false"
      aria-label={`Guardar ${nombre} en favoritos`}
    >
      <svg class="f-vacio" width="18" height="17" viewBox="0 0 24 22" aria-hidden="true" focusable="false"><use href="#i-heart-o" /></svg>
      <svg class="f-lleno" width="18" height="17" viewBox="0 0 24 22" aria-hidden="true" focusable="false"><use href="#i-heart" /></svg>
    </button>
    <a class="wa-mini" href={waLink(mensajeWa)} target="_blank" rel="noopener" aria-label={`Pedir ${nombre} por WhatsApp`}>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-wa" /></svg>
    </a>
  </div>

  <h3 class="name"><a href={`/catalogo/${producto.id}`}>{nombre}</a></h3>
  <p class="desc">{descripcion}</p>
  <p class="price">
    <span>{soles(actual)}</span>
    {oferta !== undefined && <s><span class="sr-only">antes </span>{soles(precio)}</s>}
  </p>
  <div class="row">
    <button type="button" class="add" data-add={producto.id}>
      <svg width="18" height="18" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><use href="#i-basket" /></svg>
      <span>Agregar a la canasta</span>
    </button>
  </div>
</article>

<script>
  const CLAVE = 'vl-favs';

  function leerFavs(): string[] {
    try {
      const data: unknown = JSON.parse(localStorage.getItem(CLAVE) ?? '[]');
      return Array.isArray(data) ? data.filter((x): x is string => typeof x === 'string') : [];
    } catch {
      return [];
    }
  }

  function guardarFavs(favs: string[]): void {
    try {
      localStorage.setItem(CLAVE, JSON.stringify(favs));
    } catch {
      /* sin almacenamiento: el favorito solo dura la página */
    }
  }

  function pintarFavs(): void {
    const favs = new Set(leerFavs());
    document.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => {
      const slug = b.dataset.fav ?? '';
      const on = favs.has(slug);
      b.setAttribute('aria-pressed', String(on));
      const nombre = b.dataset.nombre ?? '';
      b.setAttribute('aria-label', on ? `Quitar ${nombre} de favoritos` : `Guardar ${nombre} en favoritos`);
    });
  }

  pintarFavs();

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const boton = e.target.closest<HTMLButtonElement>('[data-fav]');
    const slug = boton?.dataset.fav;
    if (!slug) return;
    const favs = leerFavs();
    const i = favs.indexOf(slug);
    if (i >= 0) favs.splice(i, 1);
    else favs.push(slug);
    guardarFavs(favs);
    pintarFavs();
  });
</script>

<style>
  .card {
    position: relative;
    flex: 0 0 var(--vl-card-w);
    width: var(--vl-card-w);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: var(--vl-radius);
    background: var(--vl-blanco);
    box-shadow: var(--vl-shadow);
    transition: transform 0.4s var(--vl-ease), box-shadow 0.4s var(--vl-ease);
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--vl-shadow-lg); }
  .card:has(.name a:focus-visible) {
    outline: 3px solid var(--vl-frambuesa);
    outline-offset: 3px;
  }

  .ph {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-bottom: 8px;
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 58%, var(--vl-blush) 0 52%, transparent 53%),
      var(--vl-crema);
  }
  .ph :global(img) {
    width: 84%;
    height: 92%;
    object-fit: contain;
    filter: var(--vl-drop);
    transition: transform 0.5s var(--vl-ease);
  }
  .card:hover .ph :global(img) { transform: scale(1.05); }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 4px 10px;
    border-radius: var(--vl-radius-pill);
    background: var(--vl-frambuesa);
    color: var(--vl-blanco);
    font-family: var(--vl-font-ui);
    font-weight: 600;
    font-size: 13px;
  }

  .fav {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--vl-blanco);
    box-shadow: var(--vl-shadow);
    color: var(--vl-frambuesa);
  }
  .fav svg { width: 18px; height: 17px; }
  .fav .f-lleno { display: none; }
  .fav[aria-pressed="true"] .f-lleno { display: block; }
  .fav[aria-pressed="true"] .f-vacio { display: none; }

  .wa-mini {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--vl-blanco);
    box-shadow: var(--vl-shadow);
    color: var(--vl-whatsapp-oscuro);
    transition: background 0.3s, color 0.3s;
  }
  .wa-mini:hover { background: var(--vl-whatsapp); color: var(--vl-whatsapp-tinta); }

  .name {
    min-height: 2.4em;
    font-family: var(--vl-font-title);
    font-weight: 800;
    font-size: 19px;
    line-height: 1.2;
    color: var(--vl-vino);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .name a:focus-visible { outline: none; }

  .desc {
    min-height: 2.9em;
    font-size: 14px;
    line-height: 1.45;
    color: var(--vl-tinta-suave);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--vl-font-ui);
    font-weight: 600;
    font-size: 20px;
    color: var(--vl-frambuesa);
  }
  .price s {
    font-size: 14px;
    font-weight: 500;
    color: var(--vl-tinta-suave);
  }

  .row {
    margin-top: auto;
    padding-top: 8px;
  }
  .add {
    position: relative;
    z-index: 2;
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 11px 14px;
    border-radius: var(--vl-radius-pill);
    background: var(--vl-frambuesa);
    color: var(--vl-blanco);
    font-family: var(--vl-font-ui);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    transition: transform 0.25s var(--vl-ease), background 0.3s;
  }
  .add svg { flex: none; width: 18px; height: 18px; }
  .add:hover { background: var(--vl-frambuesa-oscuro); }
  .add:active { transform: scale(0.95); }
  .add.done { background: var(--vl-follaje); }
</style>
