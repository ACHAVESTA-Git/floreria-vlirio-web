---
/**
 * Pie del drawer: dedicatoria, total y botón "Pedir por WhatsApp". basketRender.ts pone el total y el enlace.
 */
---

<footer class="pie">
  <label for="cardMsg">Mensaje para la tarjeta (opcional)</label>
  <textarea id="cardMsg" maxlength="300" placeholder="Escribe aquí tu dedicatoria"></textarea>
  <div class="total">
    <span>Total</span>
    <span id="total">S/0</span>
  </div>
  <a class="btn btn-wa pedir" id="checkout" target="_blank" rel="noopener noreferrer">Pedir por WhatsApp</a>
</footer>

<style>
  .pie {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 22px 22px;
    border-top: 1px solid var(--vl-durazno);
    background: var(--vl-blanco);
  }
  .pie label {
    font-size: 14px;
    color: var(--vl-tinta-suave);
  }
  .pie textarea {
    width: 100%;
    height: 62px;
    padding: 10px 12px;
    border: 1px solid var(--vl-durazno);
    border-radius: 14px;
    background: var(--vl-crema);
    color: var(--vl-tinta);
    font: inherit;
    font-size: 16px;
    resize: none;
  }
  .total {
    display: flex;
    justify-content: space-between;
    font-family: var(--vl-font-ui);
    font-weight: 600;
    font-size: 18px;
    color: var(--vl-vino);
  }
  .pedir { width: 100%; justify-content: center; }
  .pedir.off,
  .pedir[aria-disabled="true"] { opacity: 0.5; pointer-events: none; }
</style>
