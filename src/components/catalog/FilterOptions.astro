---
import type { Faceta } from '../../lib/catalogFacets';

/** Lista de opciones con casilla (ocasión) o muestra de color (color). */
interface Props {
  /** "ocasion": casilla y data-filter-oca. "color": muestra y data-filter-color. */
  tipo: 'ocasion' | 'color';
  /** Nombre del grupo para lectores de pantalla. */
  grupo: string;
  items: Faceta[];
}
const { tipo, grupo, items } = Astro.props;
// Los dos tipos comparten marcado: solo cambian el atributo que lee el JS y el indicador visual.
const esColor = tipo === 'color';
const atributo = esColor ? 'data-filter-color' : 'data-filter-oca';
---

<div class:list={['opts', { 'opts-color': esColor }]} role="group" aria-label={grupo}>
  {
    items.map((o) => (
      <button type="button" class="opt" {...{ [atributo]: o.slug }} aria-pressed="false">
        {
          esColor ? (
            <span class="swatch" aria-hidden="true" style={`--sw: var(--vl-color-${o.slug})`} />
          ) : (
            <span class="check" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          )
        }
        <span class="opt-t">{o.nombre}</span>
        <span class="opt-n" aria-label={`${o.n} productos`}>{o.n}</span>
      </button>
    ))
  }
</div>

<style>
  .opts {
    display: grid;
    padding-bottom: 12px;
  }
  .opts-color {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 4px;
    border-radius: 12px;
    font-family: var(--vl-font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--vl-tinta);
    text-align: left;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  @media (hover: hover) {
    .opt:hover {
      background: var(--vl-blush);
    }
  }
  .opt-t {
    flex: 1;
    min-width: 0;
  }
  .opt-n {
    font-family: var(--vl-font-ui);
    font-size: 13px;
    color: var(--vl-tinta-suave);
  }
  .check {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--vl-vino);
    border-radius: 6px;
    background: var(--vl-blanco);
    color: transparent;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }
  .opt[aria-pressed='true'] .check {
    background: var(--vl-vino);
    color: var(--vl-blanco);
  }
  .opt[aria-pressed='true'] .opt-t {
    color: var(--vl-vino);
  }
  .swatch {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: inset 0 0 0 1px var(--vl-borde-muestra); /* el borde marca los colores claros (blanco, amarillo) */
    transition: box-shadow 0.18s ease;
  }
  .opt[aria-pressed='true'] .swatch {
    box-shadow:
      0 0 0 2px var(--vl-crema),
      0 0 0 4px var(--vl-vino);
  }

  @media (min-width: 1024px) {
    .opt {
      min-height: 38px;
      font-size: 14.5px;
    }
    .opts-color {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .check,
    .swatch {
      transition: none;
    }
  }
</style>
