---
/** Botón flotante de WhatsApp (todas las páginas). El tooltip aparece una sola vez por sesión, tras 2 pantallas de scroll. */
import { waLink } from '../../config/site';

const WA_HREF = waLink("Hola V'Lirio 🌷, quiero información sobre sus arreglos");
---

<a class="wa-float" href={WA_HREF} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" data-wa-float>
  <svg width="30" height="30" aria-hidden="true" focusable="false"><use href="#i-wa" /></svg>
</a>
<p class="wa-tip" role="status" data-wa-tip>¿Te ayudamos a elegir? 🌷</p>

<style>
  .wa-float {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--vl-whatsapp);
    color: var(--vl-whatsapp-tinta);
    box-shadow: 0 12px 24px -8px color-mix(in srgb, var(--vl-whatsapp) 60%, transparent);
    transition: transform 0.3s var(--vl-ease), background 0.3s;
  }
  .wa-float:hover {
    transform: scale(1.08);
    background: var(--vl-whatsapp-hover);
  }
  .wa-float svg {
    width: 30px;
    height: 30px;
  }
  .wa-tip {
    position: fixed;
    right: 86px;
    bottom: 30px;
    z-index: 60;
    max-width: 240px;
    margin: 0;
    padding: 8px 14px;
    border-radius: 14px 14px 4px 14px;
    background: var(--vl-blanco);
    color: var(--vl-tinta);
    font-size: 14px;
    box-shadow: var(--vl-shadow);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--vl-ease), transform 0.4s var(--vl-ease);
    pointer-events: none;
  }
  .wa-tip.on {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 640px) {
    .wa-tip {
      right: 84px;
      bottom: 32px;
    }
  }
</style>

<script>
  const KEY = 'vl-wa-tip';
  const tip = document.querySelector<HTMLElement>('[data-wa-tip]');
  let mostrado = false;
  try {
    mostrado = window.sessionStorage.getItem(KEY) === '1';
  } catch {
    mostrado = false;
  }

  const revisar = (): void => {
    if (mostrado || !tip) return;
    if (window.scrollY <= window.innerHeight * 2) return;
    mostrado = true;
    try {
      window.sessionStorage.setItem(KEY, '1');
    } catch {
      // Sin almacenamiento: el tooltip se muestra una vez por carga de página
    }
    tip.classList.add('on');
    window.setTimeout(() => tip.classList.remove('on'), 4000);
    window.removeEventListener('scroll', revisar);
  };

  if (tip && !mostrado) {
    window.addEventListener('scroll', revisar, { passive: true });
    revisar();
  }
</script>
